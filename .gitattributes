# Keep shell scripts LF so they run correctly on the Linux server image
# (a CRLF bash script fails with "\r: command not found").
*.sh text eol=lf
*.ps1 text eol=lf

# Source files stay LF.
*.go text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
