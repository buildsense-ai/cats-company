{
  "name": "catsco-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --strictPort",
    "dev:shared": "node scripts/shared-preview.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --strictPort",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/site-contracts.test.mjs",
    "check": "pnpm test && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "framer-motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "6.4.3"
  }
}
