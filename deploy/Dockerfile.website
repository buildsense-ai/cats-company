FROM node:24-alpine3.24 AS website-build

WORKDIR /app

RUN corepack enable pnpm
COPY website/package.json website/pnpm-lock.yaml website/pnpm-workspace.yaml ./
RUN --mount=type=cache,id=catscompany-website-pnpm,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile

COPY website/ ./
ARG VITE_APP_BASE_URL=https://app.catsco.cc
ENV VITE_APP_BASE_URL=${VITE_APP_BASE_URL}
RUN pnpm run build

FROM nginx:1.27-alpine
COPY deploy/website-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=website-build /app/dist /usr/share/nginx/html
