COMPOSE_PROJECT_NAME=catscompany_prod
PROD_STACK_ROOT=/srv/catscompany-prod
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=replace-with-github-owner
IMAGE_TAG=replace-with-a-commit-sha
DREAMINA_IMAGE_TAG=replace-with-a-commit-sha

PROD_API_BIND_HOST=127.0.0.1
PROD_API_HOST_PORT=26061
PROD_GRPC_BIND_HOST=127.0.0.1
PROD_GRPC_HOST_PORT=26062
PROD_WEB_BIND_HOST=127.0.0.1
PROD_WEB_HOST_PORT=28080

# Current production uses PostgreSQL. Replace the host and password in prod.env.
OC_DB_DRIVER=postgres
OC_DB_DSN=postgres://catsco:replace-with-password@postgres.internal:5432/catsco?sslmode=prefer
# Optional MySQL example for isolated local deployments:
# OC_DB_DRIVER=mysql
# OC_DB_DSN=openchat:replace-with-a-strong-db-password@tcp(host.docker.internal:3306)/openchat?parseTime=true&charset=utf8mb4
OC_DB_MAX_OPEN_CONNS=25
OC_DB_MAX_IDLE_CONNS=10
OC_DB_CONN_MAX_LIFETIME=30m
OC_DB_CONN_MAX_IDLE_TIME=5m
# Optional shared runtime for multi-instance bot body leases and Device RPC routing.
# Leave empty for single-instance process-local mode.
OC_RUNTIME_STORE=
OC_REDIS_URL=
OC_REDIS_KEY_PREFIX=catsco:prod
CATSCO_NODE_ID=
# MySQL-only guard. Keep disabled unless sharing the openchat DB user is intentional.
ALLOW_SHARED_DB_USER=0
OC_JWT_SECRET=replace-with-a-random-jwt-secret-at-least-64-chars

# Optional Web Push notifications. Leave all three values empty to disable them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional mainland egress relay. Set both values to route signed Web Push
# requests through the constrained Cloudflare Worker relay.
CATSCO_PUSH_RELAY_URL=
CATSCO_PUSH_RELAY_TOKEN=
# Optional. Enables service-to-service account center APIs.
# Prefer sha256:<hex-sha256> in production instead of storing plaintext service tokens.
OC_ACCOUNT_SERVICE_TOKENS=

# Tencent Cloud SES email verification.
TENCENTCLOUD_SECRET_ID=replace-with-tencent-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-tencent-secret-key
TENCENTCLOUD_REGION=ap-guangzhou
TENCENT_SES_FROM_EMAIL=noreply@mail.catsco.cc
TENCENT_SES_FROM_NAME=Cats Company
TENCENT_SES_TEMPLATE_ID=174748
TENCENT_SES_SUBJECT=Cats Company 注册验证码
# Optional. Defaults to TENCENT_SES_FROM_EMAIL when empty.
TENCENT_SES_REPLY_TO=

# Optional. Reuse the ops monitor Feishu bot for user feedback notifications.
FEISHU_WEBHOOK_URL=
FEISHU_KEYWORD=cats-company
# Optional override if feedback should use a separate Feishu bot.
FEEDBACK_FEISHU_WEBHOOK_URL=
FEEDBACK_FEISHU_KEYWORD=
# Optional. Used to turn /uploads/feedback/... into a full URL in Feishu.
FEEDBACK_PUBLIC_BASE_URL=https://app.catsco.cc

# Optional. Device Connector release metadata shown in the web pairing dialog.
CATSCO_DEVICE_CONNECTOR_VERSION=
CATSCO_DEVICE_CONNECTOR_RELEASE_BASE_URL=

# Optional authenticated image-generation proxy. Set real values only in the
# persistent server file /srv/catscompany-prod/env/prod.env, never in GitHub Actions.
CATSCO_IMAGE_UPSTREAMS_FILE=
CATSCO_IMAGE_UPSTREAM_URL=
CATSCO_IMAGE_UPSTREAM_API_KEY=
CATSCO_IMAGE_UPSTREAM_API_KEY_FILE=
CATSCO_IMAGE_MODEL=gpt-image-2
CATSCO_IMAGE_TIMEOUT_SECONDS=540
CATSCO_IMAGE_RACE_DEADLINE_SECONDS=270
CATSCO_IMAGE_RACE_BACKOFF_MS=750
CATSCO_IMAGE_RACE_MAX_ATTEMPTS_PER_PROVIDER=2
CATSCO_IMAGE_MAX_REQUEST_BYTES=1048576
CATSCO_IMAGE_EDIT_MAX_REQUEST_BYTES=25165824
CATSCO_IMAGE_MAX_RESPONSE_BYTES=41943040
CATSCO_DREAMINA_WORKER_URL=http://dreamina-worker:7070
CATSCO_DREAMINA_WORKER_TIMEOUT_SECONDS=150
DREAMINA_WORKER_POLL_WAIT_SECONDS=12
DREAMINA_CLI_TIMEOUT_MS=120000
DREAMINA_IMAGE_PROMPT_MAX_CHARS=900

# CatsCo cloud Feishu channel. Configure these with your enterprise self-built
# Feishu app, then set the same callback URLs in Feishu Open Platform.
CATSCO_PUBLIC_BASE_URL=https://app.catsco.cc
CATSCO_PUBLIC_WS_URL=wss://app.catsco.cc/v0/channels
CATSCO_FEISHU_APP_ID=
CATSCO_FEISHU_APP_SECRET=
# Required for Dashboard Feishu QR readiness. This must be a real Feishu
# native app/bot entry URL, and it must carry the CatsCo scene back through
# {landing_url_encoded}, {oauth_url_encoded}, or {scene_key}.
# Supports {scene_key}, {scene_key_encoded}, {app_id}, {app_id_encoded},
# {landing_url}, {landing_url_encoded}, {oauth_url}, {oauth_url_encoded},
# {entry_url}, {entry_url_encoded}.
CATSCO_FEISHU_ENTRY_URL_TEMPLATE=
CATSCO_FEISHU_OAUTH_REDIRECT_URI=https://app.catsco.cc/api/channel-agent-bindings/oauth/feishu/callback
# Feishu Events & Callbacks Request URL:
# https://app.catsco.cc/api/channels/feishu/events
# Keep event encryption disabled for now; this endpoint accepts plaintext events.
CATSCO_FEISHU_EVENT_VERIFICATION_TOKEN=
CATSCO_FEISHU_OAUTH_STATE_SECRET=
# Optional bot identity overrides. The server discovers the current app bot's
# open_id from Feishu automatically. Explicit IDs remain available for
# compatibility; aliases only apply to legacy events without immutable IDs.
CATSCO_FEISHU_GROUP_BOT_OPEN_IDS=
CATSCO_FEISHU_GROUP_BOT_ALIASES=
# Group participants and inherited virtual employees are resolved dynamically
# from Feishu events and CatsCo bindings; do not maintain them in environment variables.
# Required in production if external channel adapters call /api/channel-agent-bindings/resolve.
CATSCO_CHANNEL_BINDING_TOKEN=

# CatsCo cloud Weixin official-account channel. Configure these with the
# Official Accounts Platform app, then set the same callback in its server config.
# CATSCO_PUBLIC_BASE_URL must be this production public HTTPS origin.
CATSCO_WEIXIN_APP_ID=
CATSCO_WEIXIN_APP_SECRET=
# Weixin Official Accounts Platform Server URL:
# https://app.catsco.cc/api/channels/weixin/events
# Token: same value as CATSCO_WEIXIN_EVENT_TOKEN
# Message encryption: plaintext or compatible plaintext mode. AES-only mode is not enabled yet.
# If QR image generation fails, check AppSecret, API permissions, and the Weixin IP allowlist.
CATSCO_WEIXIN_EVENT_TOKEN=
# Optional. Defaults to the official Weixin API and QR display endpoints.
CATSCO_WEIXIN_API_BASE_URL=
CATSCO_WEIXIN_QR_SHOW_BASE_URL=

# Optional. Separate Weixin ClawBot iLink authorization QR settings.
# Defaults: CATSCO_WEIXIN_CLAWBOT_ILINK_BASE_URL=https://ilinkai.weixin.qq.com
# CATSCO_WEIXIN_CLAWBOT_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
# and CATSCO_WEIXIN_CLAWBOT_BOT_TYPE=3.
CATSCO_WEIXIN_CLAWBOT_ILINK_BASE_URL=
CATSCO_WEIXIN_CLAWBOT_CDN_BASE_URL=
CATSCO_WEIXIN_CLAWBOT_BOT_TYPE=
CATSCO_WEIXIN_CLAWBOT_QR_TIMEOUT_SECONDS=
CATSCO_WEIXIN_CLAWBOT_WORKER_ENABLED=
CATSCO_WEIXIN_CLAWBOT_WORKER_REFRESH_SECONDS=
CATSCO_WEIXIN_CLAWBOT_LONGPOLL_SECONDS=
# Optional: comma-separated media download hosts when iLink returns absolute CDN URLs.
# The observed Weixin ClawBot file host is novac2c.cdn.weixin.qq.com.
CATSCO_WEIXIN_CLAWBOT_MEDIA_HOST_ALLOWLIST=
# Optional: media-id download URL template if getupdates returns only file_id/media_id.
CATSCO_WEIXIN_CLAWBOT_MEDIA_DOWNLOAD_URL_TEMPLATE=

# Optional. Enables logged-in users to generate their own Bifrost Virtual Key.
# The relay admin bridge must listen on the host, e.g. http://127.0.0.1:18090.
CATS_RELAY_ADMIN_URL=http://host.docker.internal:18090
CATS_RELAY_ADMIN_TOKEN=
CATS_RELAY_ADMIN_TIMEOUT_SECONDS=15
CATSCO_MODEL_CONFIG_ENCRYPTION_KEY=
CATSCO_BOT_MODEL_CLOUD_ENABLED=true
CATSCO_BOT_MODEL_CLOUD_TEST_UIDS=
CATSCO_ARTIFACT_INDEX_URL=
CATSCO_ARTIFACT_MANAGEMENT_URL=
CATSCO_ARTIFACT_MANAGEMENT_TOKEN=
# Optional distributed routing. Set one, not both. JSON follows artifact-nodes.example.json.
# Each public_base_url must use a different origin from CATSCO_PUBLIC_BASE_URL.
CATSCO_ARTIFACT_NODES_JSON=
CATSCO_ARTIFACT_NODES_FILE=
CATSCO_SKILLHUB_BASE_URL=https://skillhub.catsco.fun:19990
CATSCO_SKILLHUB_TIMEOUT_SECONDS=15
# Bot-authenticated runtime configuration used by cloud-html-artifact.
# Production deploys populate these from repository Actions secrets with the
# same names and persist them in /srv/catscompany-prod/env/prod.env.
CATSCO_ARTIFACT_DNS_ACCESS_KEY=
CATSCO_ARTIFACT_DNS_SECRET_KEY=
CATSCO_ARTIFACT_DNS_ZONE=catsco.fun
CATSCO_ARTIFACT_HOST_SUFFIX=artifacts.catsco.fun
# One-server-per-Agent static Artifact discovery. Set empty to disable.
CATSCO_DIRECT_ARTIFACT_URL_TEMPLATE=https://agent-{uid}.artifacts.catsco.fun:19991/artifacts
CATS_RELAY_PUBLIC_BASE_URL=https://relay.catsco.cc
CATS_RELAY_OPENAI_BASE_URL=https://relay.catsco.cc/v1
CATS_RELAY_ANTHROPIC_BASE_URL=https://relay.catsco.cc/anthropic
CATS_RELAY_DEFAULT_MODEL=MiniMax-M2.7
CATS_RELAY_DOCS_URL=https://relay.catsco.cc
# Shared HMAC secret for one-time relay login tickets.
CATS_RELAY_SSO_SECRET=

# Optional. Relay commercial package rollout.
# Keep public disabled during rollout; list internal user ids in CATS_RELAY_COMMERCIAL_TEST_UIDS.
# Keep enforce disabled until admin dry-run confirms relay limits can be safely synced.
CATS_RELAY_COMMERCIAL_ENABLED=0
CATS_RELAY_COMMERCIAL_TEST_UIDS=
CATS_RELAY_COMMERCIAL_ENFORCE_ENABLED=0
CATS_RELAY_COMMERCIAL_ENFORCE_UIDS=

# Relay usage admin portal (internal). Comma-separated uid whitelist;
# leave empty to disable the portal entirely. Set the real uid(s) directly in
# the server env/prod.env (do not commit them to a public repository).
CATSCO_ADMIN_UID_WHITELIST=
# Local relay admin URL (same host; never expose relay 18090 to the public).
# host.docker.internal because the server runs inside the compose network, where
# 127.0.0.1 is the container itself, not the host running relay-admin.
CATSCO_RELAY_ADMIN_URL=http://host.docker.internal:18090
