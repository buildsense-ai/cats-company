# 复制到 Slurm 登录节点的 /etc/catsco/hpc-task-worker.env，权限设为 0600。
CATS_COMPUTE_WORKER_TOKEN=replace-with-the-Cats-worker-token
CTYUN_AK=replace-with-the-tianyi-cloud-subaccount-ak
CTYUN_SK=replace-with-the-tianyi-cloud-subaccount-sk
# 将实际 Slurm bin 目录置于 PATH 的首位。
# PATH=/path/to/slurm/bin:/usr/local/bin:/usr/bin
