FROM node:24-alpine3.24 AS webapp-build

WORKDIR /app

RUN apk add --no-cache brotli gzip

COPY webapp/package.json webapp/package-lock.json ./
RUN --mount=type=cache,id=catscompany-web-npm,target=/root/.npm,sharing=locked \
    npm ci --prefer-offline --no-audit --no-fund

ARG REACT_APP_API_BASE=""
ENV VITE_API_BASE=${REACT_APP_API_BASE}

COPY webapp/ ./

RUN npm run build

RUN find build -type f \( \
    -name '*.css' -o \
    -name '*.html' -o \
    -name '*.js' -o \
    -name '*.mjs' -o \
    -name '*.json' -o \
    -name '*.svg' -o \
    -name '*.txt' \
  \) -exec gzip -kf -9 {} \; \
  -exec brotli -f -q 11 {} \;

FROM georgjung/nginx-brotli:latest@sha256:488e48d7773deef7f696a25362da3043e3aabb447c6f28548eda7391a27c7fc9

COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=webapp-build /app/build /usr/share/nginx/html
